{
  "name": "ospan-pegasus-fhir",
  "version": "0.1.0",
  "description": "Backend que consulta ordenes medicas de Pegasus (Panda HIS) y las expone en formato original y transformadas a recursos FHIR R4. Primer componente del Repositorio de Datos Clinicos de OSPAN.",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:mock": "tsx scripts/testWithMock.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
